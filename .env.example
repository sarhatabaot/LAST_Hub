# Copy to .env and fill in. Compose substitutes these into the container env.
# Anything left blank stays unset inside the container.

# Optional: build/runtime proxy settings for Docker and the app containers.
# Fill these in only if this machine needs an HTTP(S) proxy to reach the internet.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Hosts the Django app will accept. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Umami analytics (leave blank to disable the script tag).
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Israel Meteorological Service (IMS) credentials for the ICON forecast feed.
# When unset, the forecast fetcher logs a warning and the forecast page renders empty.
IMS_USERNAME=
IMS_PASSWORD=

# Controller service. The hub talks to it over HTTP (the boundary stays even
# when controller and hub run in the same Django process). Backend is "mock"
# for development; "matlab" wires up the real obs.superunit session and is
# not implemented yet.
CONTROLLER_API_BASE_URL=http://localhost:8000/controller
CONTROLLER_BACKEND=mock
CONTROLLER_MOCK_UNITS=4

# MediaMTX HLS basic-auth credentials. Used server-side by the cameras
# proxy so the browser never sees them. Leave blank for an unauthenticated
# MediaMTX deployment.
MEDIAMTX_USERNAME=
MEDIAMTX_PASSWORD=
